# Run ./ops/observability-stack.sh env to create .env with random local secrets.
# Do not copy these placeholders into a running stack.
POSTGRES_USER=ignite
POSTGRES_DB=ignite
POSTGRES_PASSWORD=generated
DATABASE_URL=postgresql://ignite:generated@127.0.0.1:15432/ignite
LANGFUSE_DATABASE_URL=postgresql://ignite:generated@postgres:5432/langfuse
LANGFUSE_PUBLIC_KEY=generated
LANGFUSE_SECRET_KEY=generated
LANGFUSE_AUTH_BASE64=generated
LANGFUSE_SALT=generated
LANGFUSE_ENCRYPTION_KEY=generated
LANGFUSE_NEXTAUTH_SECRET=generated
LANGFUSE_ADMIN_EMAIL=operator@ignite.local
LANGFUSE_ADMIN_PASSWORD=generated
CLICKHOUSE_PASSWORD=generated
REDIS_PASSWORD=generated
MINIO_PASSWORD=generated
GRAFANA_ADMIN_PASSWORD=generated
# Optional native route; the probe records delivery failures, never hides them.
DRASI_ALERT_URL=
