# Every port, name and key this demo copy uses. Read by compose.yaml (through
# ops/observability-stack.sh), the ops/ scripts, the Server config generator,
# the AI service, the web app and the tests. No secrets: the web app is given
# these values. An exported variable with the same name overrides a line here;
# IGNITE_SETTINGS=<file> selects another file (ports.default.env holds the
# values of the original demo).
#
# These values let this copy run beside the original demo: every port +1000,
# its own container project, replication names and browser storage key.

# Podman compose project; containers are named <project>-<service>-1.
IGNITE_PROJECT=ignite-native

# PostgreSQL logical replication that Drasi's PostgreSQL source reads.
IGNITE_PG_PUBLICATION=ignite_rework
IGNITE_PG_SLOT=ignite_rework

# Browser localStorage key and BroadcastChannel name for the presenter stage.
IGNITE_STORAGE_KEY=ignite-native-stage-v1

# Drasi Server API and UI.
IGNITE_DRASI_API_PORT=19421
# Drasi HTTP source (Grafana alert webhooks).
IGNITE_DRASI_ALERT_PORT=19422
# Drasi Prometheus reaction (/metrics), scraped by the Prometheus container.
IGNITE_DRASI_METRICS_PORT=19423
# Drasi SSE reaction: the desk's live results (one event stream, snapshots per output).
IGNITE_DRASI_SSE_PORT=19424
# AI service: gateway, demo controls, approval tool, gateway configuration API.
IGNITE_WORKLOAD_PORT=19500
# Simulated model deployments.
IGNITE_DEPLOYMENT_EU_A_PORT=19531
IGNITE_DEPLOYMENT_EU_B_PORT=19532
IGNITE_DEPLOYMENT_US_C_PORT=19533
# Slides and presenter desk; the browser-test copy and its fixture server.
IGNITE_UI_PORT=19580
IGNITE_UI_TEST_PORT=19581
IGNITE_UI_FIXTURE_PORT=19582
# Containers (host side of the published port).
IGNITE_GRAFANA_PORT=14000
IGNITE_LANGFUSE_PORT=14001
IGNITE_OTLP_PORT=15318
IGNITE_POSTGRES_PORT=16432
IGNITE_PROMETHEUS_PORT=20090
IGNITE_PROBE_PORT=19888
