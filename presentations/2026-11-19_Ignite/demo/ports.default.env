# The original demo's values (see ports.env for what each one is). Use them
# with IGNITE_SETTINGS=ports.default.env. Never run that beside the original
# demo: it uses the same ports, containers and volumes.
IGNITE_PROJECT=ignite-observability
IGNITE_PG_PUBLICATION=ignite_native
IGNITE_PG_SLOT=ignite_native
IGNITE_STORAGE_KEY=ignite-presentation-stage-v3
IGNITE_DRASI_API_PORT=18421
IGNITE_DRASI_METRICS_PORT=18423
# Drasi SSE reaction: the desk's live results (one event stream, snapshots per output).
IGNITE_DRASI_SSE_PORT=18424
IGNITE_WORKLOAD_PORT=18500
IGNITE_DEPLOYMENT_EU_A_PORT=18531
IGNITE_DEPLOYMENT_EU_B_PORT=18532
IGNITE_DEPLOYMENT_US_C_PORT=18533
IGNITE_UI_PORT=18580
IGNITE_UI_TEST_PORT=18581
IGNITE_UI_FIXTURE_PORT=18582
IGNITE_GRAFANA_PORT=13000
IGNITE_LANGFUSE_PORT=13001
IGNITE_OTLP_PORT=14318
IGNITE_POSTGRES_PORT=15432
IGNITE_PROMETHEUS_PORT=19090
IGNITE_PROBE_PORT=18888
IGNITE_MATTERMOST_PORT=18065
