        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 10,
      "key": "alerts-firing",
      "type": "alertlist",
      "title": "Alerts firing",
      "description": "Grafana's alert rules that are firing now: Model calls failing, and Support requests overdue (an alert on Drasi's answer). Each also posts to #incident-ai-support.",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 6
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 5,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "{component=\"workload\"}",
        "folder": null,
        "showInstances": false,
        "stateFilter": {
          "firing": true,
          "pending": false,
          "noData": false,
          "normal": false,
          "error": true,
          "recovering": false
        }
      }
    },
    {
      "id": 5,
      "key": "model-calls-chart",
      "type": "timeseries",
      "title": "Model calls by workload",
      "description": "Model calls per second, by workload and whether they succeeded. Failed calls are retried.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 6
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_gateway_model_calls_total{workload=\"support\",status=\"200\"}[30s])) or vector(0)",
          "legendFormat": "support answered"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_gateway_model_calls_total{workload=\"batch\",status=\"200\"}[30s])) or vector(0)",
          "legendFormat": "summaries answered"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ai_gateway_model_calls_total{workload=\"support\",status!=\"200\"}[30s])) or vector(0)",
          "legendFormat": "support failed"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ai_gateway_model_calls_total{workload=\"batch\",status!=\"200\"}[30s])) or vector(0)",
          "legendFormat": "summaries failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "support answered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8DC8E8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "summaries answered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C5B4E3"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "support failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFB3BB"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "summaries failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFE399"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "key": "support-waiting",
      "type": "timeseries",
      "title": "Support requests waiting",
      "description": "Support requests waiting for an answer, and how many are past their 15-second deadline according to Drasi.",
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ai_gateway_queue_depth{workload=\"support\"}",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "expr": "max((max(drasi_requests_overdue{workload=\"support\"}) and on() (drasi_reaction_input_ready{output=\"overdue\"} == 1)) or on() ((drasi_reaction_input_ready{output=\"overdue\"} == 1) * 0 + 0))",
          "legendFormat": "overdue (Drasi)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "softMax": 10
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "waiting"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFE399"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "overdue (Drasi)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFB3BB"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 101,
      "key": "decision-support",
      "type": "row",
      "title": "Decision Support",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "key": "support-overdue",
      "type": "stat",
      "title": "Support overdue",
      "description": "Customer-support requests past their 15-second deadline, from a Drasi continuous query. A request becomes overdue as time passes, with no new event.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((max(drasi_requests_overdue{workload=\"support\"}) and on() (drasi_reaction_input_ready{output=\"overdue\"} == 1)) or on() ((drasi_reaction_input_ready{output=\"overdue\"} == 1) * 0 + 0))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "#9AA4B0"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8DE971",
                "value": null
              },
              {
                "color": "#FFB3BB",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 44
        }
      }
    },
    {
      "id": 8,
      "key": "deployment-status",
      "type": "stat",
      "title": "Deployment status",
      "description": "Each deployment's health as Drasi derives it from its health-probe telemetry. Unknown means no probe for 8 seconds: Drasi notices silence as time passes.",
      "gridPos": {
        "x": 4,
        "y": 12,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(drasi_deployment_health_status and on() (drasi_reaction_input_ready{output=\"deployments\"} == 1))",
          "instant": true,
          "range": false,
          "interval": "1s",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                },
                "0": {
                  "text": "Healthy",
                  "color": "#8DE971"
                },
                "1": {
                  "text": "Over quota",
                  "color": "#FFE399"
                },
                "2": {
                  "text": "Failed",
                  "color": "#FFB3BB"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "#9AA4B0"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 24,
          "valueSize": 24
        }
      }
    },
    {
      "id": 9,
      "key": "workload-status",
      "type": "stat",
      "title": "Workload status",
      "description": "Each workload where it runs now, from a Drasi continuous query over its route, the placement policy and its deployment's health: Healthy, Over quota or Failing as its deployment is; Not allowed when policy no longer allows it there; Unknown when its deployment has been silent for 8 seconds.",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(drasi_workload_status{workload=\"support\"} and on() (drasi_reaction_input_ready{output=\"workloads\"} == 1))",
          "instant": true,
          "range": false,
          "interval": "1s",
          "legendFormat": "{{name}} · {{deployment}}"
        },
