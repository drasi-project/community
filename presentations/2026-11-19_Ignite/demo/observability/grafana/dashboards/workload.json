{
  "uid": "ai-operations",
  "title": "AI service · Operations",
  "schemaVersion": 39,
  "version": 37,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "ai-platform",
    "workload"
  ],
  "description": "AI Deployments: ordinary monitoring, measured from real requests. Decision Support: Drasi's answers, computed from changes. Deployments and capacity are simulated.",
  "annotations": {
    "list": [
      {
        "name": "Show Drasi decisions on charts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8DE971",
        "target": {
          "type": "tags",
          "tags": [
            "drasi-decision"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "#incident-ai-support",
      "url": "http://localhost:19065/ai-platform/channels/incident-ai-support",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Langfuse traces",
      "url": "http://localhost:14001/project/ignite-probe/traces?filter=isRootObservation%3Bboolean%3B%3B%3D%3Btrue",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 200,
      "key": "panel-menus",
      "type": "text",
      "title": "",
      "transparent": true,
      "description": "Keeps every panel's menu visible (no content).",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "options": {
        "mode": "html",
        "content": "<style>button[data-testid^=\"data-testid Panel menu\"].show-on-hover{opacity:1!important;visibility:visible!important;background:none}[data-viz-panel-key=\"panel-200\"]{pointer-events:none}</style>"
      }
    },
    {
      "id": 100,
      "key": "ai-deployments",
      "type": "row",
      "title": "AI Deployments",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "key": "model-calls",
      "type": "stat",
      "title": "Model calls",
      "description": "Calls to the AI model per second, both workloads, over the last 30 seconds.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_gateway_model_calls_total[30s]))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "#9AA4B0"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 2,
      "key": "support-errors",
      "type": "stat",
      "title": "Support errors",
      "description": "Share of customer-support model calls that failed in the last 30 seconds.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(ai_gateway_model_calls_total{workload=\"support\",status!=\"200\"}[30s])) or vector(0)) / sum(rate(ai_gateway_model_calls_total{workload=\"support\"}[30s]))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "#9AA4B0"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8DE971",
                "value": null
              },
              {
                "color": "#FFE399",
                "value": 5
              },
              {
                "color": "#FFB3BB",
                "value": 20
              }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 3,
      "key": "answer-time",
      "type": "stat",
      "title": "Answer time p95",
      "description": "95th percentile time from a customer's question to its answer, over the last minute. The target is 15 seconds.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(ai_gateway_answer_time_seconds_bucket{workload=\"support\"}[1m])))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No answers",
                  "color": "#FFB3BB"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "#9AA4B0"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "#9AA4B0"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8DE971",
                "value": null
              },
              {
                "color": "#FFE399",
                "value": 10
              },
              {
                "color": "#FFB3BB",
                "value": 15
              }
            ]
          },
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 4,
      "key": "support-queue",
      "type": "stat",
      "title": "Support queue",
      "description": "Customer-support requests waiting for an answer. One or two in flight is normal.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
