{
  "uid": "ignite-workload",
  "title": "AI service · Operations",
  "schemaVersion": 39,
  "version": 27,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "ignite",
    "workload"
  ],
  "description": "Top: ordinary monitoring, measured from real requests. Bottom: Drasi's answers, computed from changes. Deployments and capacity are simulated.",
  "annotations": {
    "list": [
      {
        "name": "Show Drasi decisions on charts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#52d6a4",
        "target": {
          "type": "tags",
          "tags": [
            "ignite-decision"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "Recovery plan",
      "url": "/d/ignite-decisions?from=now-5m&to=now&refresh=5s",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Langfuse traces",
      "url": "http://localhost:14001/project/ignite-probe/traces?filter=isRootObservation%3Bboolean%3B%3B%3D%3Btrue",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Monitoring · measured from requests",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Model calls",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ignite_workload_requests_total[30s]))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Support errors",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(ignite_workload_requests_total{workload=\"support\",status!=\"200\"}[30s])) or vector(0)) / sum(rate(ignite_workload_requests_total{workload=\"support\"}[30s]))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 40
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Answer time p95",
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(ignite_workload_answer_seconds_bucket{workload=\"support\"}[1m])))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No answers",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
