    {
      "title": "Operations",
      "url": "/d/ignite-workload?from=now-5m&to=now&refresh=5s",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Langfuse traces",
      "url": "http://localhost:14001/project/ignite-probe/traces?filter=isRootObservation%3Bboolean%3B%3B%3D%3Btrue",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
