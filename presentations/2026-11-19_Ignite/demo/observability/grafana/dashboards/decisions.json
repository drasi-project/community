    {
      "id": 14,
      "type": "stat",
      "title": "Capacity · tokens/min",
      "description": "Total capacity across all deployments, the part on healthy deployments, and what the workloads need. Enough in total doesn't mean there's a valid place for each workload.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ignite_workload_capacity_tpm and on() (time() - max(ignite_drasi_projection_timestamp_seconds) < 5)) / 1000",
          "legendFormat": "Total",
          "instant": true,
          "range": false,
          "interval": "1s"
        },
        {
          "refId": "B",
          "expr": "sum(ignite_workload_capacity_tpm and on(endpoint) ((ignite_drasi_dashboard{view=\"endpoint\"} and on(view) (ignite_drasi_valid_until_seconds > time())) == 0)) / 1000",
          "legendFormat": "Healthy",
          "instant": true,
          "range": false,
          "interval": "1s"
        },
        {
          "refId": "C",
          "expr": "sum(ignite_drasi_dashboard{view=\"configured\"} and on(view) (ignite_drasi_valid_until_seconds > time())) / 1000",
          "legendFormat": "Needed",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
