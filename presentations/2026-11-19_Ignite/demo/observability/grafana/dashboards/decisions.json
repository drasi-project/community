  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Action needed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(ignite_drasi_action_needed) and on() (drasi_reaction_input_ready{output=\"action\"} == 1))",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "0": {
                  "text": "None",
                  "color": "green"
                },
                "1": {
                  "text": "Approve proposed plan",
                  "color": "orange"
                },
                "2": {
                  "text": "No valid plan",
                  "color": "red"
                },
                "3": {
                  "text": "At risk",
                  "color": "orange"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No traffic",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 34
        }
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Last approval",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((max(ignite_drasi_last_approval_state) and on() (drasi_reaction_input_ready{output=\"last-approval\"} == 1)) or on() ((drasi_reaction_input_ready{output=\"last-approval\"} == 1) * 0 + 0))",
          "instant": true,
          "range": false,
          "interval": "1s"
