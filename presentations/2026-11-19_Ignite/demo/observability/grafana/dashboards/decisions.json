      "targets": [
        {
          "refId": "A",
          "expr": "label_replace((ignite_drasi_running_tpm and on() (drasi_reaction_input_ready{output=\"running\"} == 1)) != 0, \"workload\", \"summaries\", \"workload\", \"batch\") / 1000",
          "instant": true,
          "range": false,
          "interval": "1s",
          "legendFormat": "{{workload}} → {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -100000,
                "to": -0.001,
                "result": {
                  "text": "held: not allowed",
                  "color": "orange"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
