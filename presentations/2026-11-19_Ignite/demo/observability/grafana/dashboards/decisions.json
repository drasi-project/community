          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 30
        }
      }
    },
