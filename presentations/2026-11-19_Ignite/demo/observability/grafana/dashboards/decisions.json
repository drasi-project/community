      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "0": {
                  "text": "None yet",
                  "color": "#9aa4b0"
                },
                "1": {
                  "text": "Approved, applying",
                  "color": "orange"
                },
                "2": {
                  "text": "Applied, awaiting evidence",
                  "color": "orange"
                },
                "3": {
                  "text": "Applied and verified",
                  "color": "green"
                },
                "4": {
                  "text": "Rejected: out of date",
                  "color": "orange"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
