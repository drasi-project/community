{
  "uid": "ignite-decisions",
  "title": "AI service · Policy and recovery",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "ignite",
    "drasi"
  ],
  "description": "Drasi's continuous policy and models: where each workload may run, the proposed routes, and whether recovery is verified. Capacity units are simulated tokens per minute.",
  "links": [
    {
      "title": "Service operations",
      "url": "/d/ignite-workload?from=now-5m&to=now&refresh=5s",
      "targetBlank": false
    },
    {
      "title": "Langfuse traces",
      "url": "http://localhost:13001/project/ignite-probe/traces",
      "targetBlank": true
    },
    {
      "title": "Drasi queries",
      "url": "http://127.0.0.1:18421/ui/?instance=ignite",
      "targetBlank": true
    },
    {
      "title": "Closing slide",
      "url": "http://127.0.0.1:18580/present?slide=closing",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Recovery decision · Drasi",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Action needed",
      "description": "Approve proposed plan: the current routes no longer work and Drasi has a complete plan that fits policy and capacity.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "uid": "ignite-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ignite_drasi_dashboard{view=\"approval\"} and on(view) (ignite_drasi_valid_until_seconds > time())",
          "instant": true,
          "range": false,
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "0": {
                  "text": "None",
                  "color": "green"
                },
                "1": {
                  "text": "Approve proposed plan",
                  "color": "orange"
                },
                "2": {
                  "text": "No valid plan",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "wideLayout": true,
        "text": {
          "titleSize": 16,
          "valueSize": 30
        }
      }
    },
