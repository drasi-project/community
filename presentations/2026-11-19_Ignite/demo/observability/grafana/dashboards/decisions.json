        {
          "refId": "B",
          "expr": "((max(ignite_drasi_action_needed) and on() (drasi_reaction_input_ready{output=\"action\"} == 1)) == 0 or (max(ignite_drasi_action_needed) and on() (drasi_reaction_input_ready{output=\"action\"} == 1)) == 3) * 0 - 2",
          "instant": true,
          "range": false,
          "interval": "1s",
